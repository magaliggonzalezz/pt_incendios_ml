NODE_ENV=development
HOST=0.0.0.0
PORT=3000

MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@<cluster>/<base>?retryWrites=true&w=majority
MONGODB_DB_NAME=incendios_forestales_v2

# En producción usar el origen HTTPS real, por ejemplo: https://app.ejemplo.com
CORS_ORIGINS=http://localhost:5173

# Opcional si se construyen URLs públicas de recursos desde el backend.
ASSETS_BASE_URL=

R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
